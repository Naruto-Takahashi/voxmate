# AI バックエンド設定: "agy" (Antigravity CLI), "claude" (Claude Code CLI), "gemini" (Gemini Developer API)
VOXMATE_BACKEND=agy

# 作業ディレクトリ（VOXMATE.md / MEMORY.md / SOUL.md を配置）
# VOXMATE_WORKDIR=./chat_workspace

# モデル指定（利用するバックエンドに合わせて設定）
# AGY_MODEL=gemini-3.8-flash-low
# CLAUDE_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# VOICEVOX Engine URL / デフォルト話者ID (3: ずんだもん)
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3
# VOICEVOX_CHAR_INFO_DIR=

# STT 設定 (macOS arm64 は mlx-whisper、Linux/Windows は faster-whisper が自動選択)
# VOXMATE_STT=faster-whisper
# WHISPER_MODEL=large-v3-turbo
# FASTER_WHISPER_DEVICE=auto
# FASTER_WHISPER_COMPUTE_TYPE=auto

# SwitchBot API v1.1（tools/sb 利用時のみ設定）
# SWITCHBOT_TOKEN=
# SWITCHBOT_SECRET=

# ハンズフリー待機時の追加ウェイクワード（カンマ区切り）
# VOXMATE_WAKE_WORDS=秘書,アシスタント
